{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "sources": {
      "dependsOn": [
        "@c4docs/likec4-style-preset#sources"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "generate": {
      "dependsOn": ["sources"],
      "outputs": [
        "dist/**"
      ]
    },
    "pack": {
      "dependsOn": ["sources"],
      "inputs": [
        "$TURBO_DEFAULT$",
        {
          "mode": "jit",
          "globs": ["dist/**"],
        },
      ],
    }
  }
}
