{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "generate": {
      "dependsOn": [
        "sources",
        "^generate"
      ],
      "outputs": [
        "src/routeTree.gen.ts",
        "worker-configuration.d.ts",
        "styled-system/**"
      ]
    },
    "build": {
      "dependsOn": [
        "generate",
        "@c4docs/likec4-core#build",
        "@c4docs/likec4-diagram#build",
        "@c4docs/likec4-language-server#build"
      ],
      "outputs": [
        ".wrangler/deploy/**",
        "dist/**"
      ]
    }
  }
}
