{
  "$schema": "https://turbo.build/schema.json",
  "extends": [
    "//"
  ],
  "tasks": {
    "typecheck": {
      "dependsOn": [
        "@c4docs/likec4-styles#sources",
        "@c4docs/likec4-diagram#typecheck",
      ],
      "inputs": [
        "src/*.ts",
        "tsconfig.json",
      ],
      "outputs": [
        "lib/**",
        "*.tsbuildinfo"
      ],
      "outputLogs": "new-only"
    },
    "build": {
      "dependsOn": [
        "typecheck",
      ],
      "outputs": [
        "dist/**",
        "styled-system/**"
      ],
      "outputLogs": "new-only"
    }
  }
}
