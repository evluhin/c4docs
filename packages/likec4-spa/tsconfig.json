{
  "extends": "@c4docs/likec4-tsconfig/react-lib.json",
  "compilerOptions": {
    "customConditions": [
      "sources"
    ],
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ESNext"
    ],
    "noPropertyAccessFromIndexSignature": false,
    "module": "preserve",
    "types": [
      "vite/client",
      "@c4docs/likec4-vite-plugin/modules"
    ]
  },
  "include": [
    "src/",
    "codegen/",
    "styled-system/",
    "*.ts",
    "package.json"
  ],
  "references": [
    {
      "path": "../core/"
    },
    {
      "path": "../layouts/"
    },
    {
      "path": "../vite-plugin/"
    },
    {
      "path": "../diagram/"
    },
    {
      "path": "../../devops/"
    }
  ]
}
