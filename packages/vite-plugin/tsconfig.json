{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@c4docs/likec4-tsconfig/base.json",
  "compilerOptions": {
    "exactOptionalPropertyTypes": false,
    "customConditions": [
      "sources"
    ],
    "composite": true,
    "incremental": true,
    "lib": [
      "ES2024"
    ],
    "target": "ES2024",
    "rootDirs": [
      "src",
      "."
    ],
    "types": [
      "node"
    ],
    "paths": {
      "@c4docs/likec4/vite-plugin/internal": [
        "./src/internal.ts"
      ],
      "@c4docs/likec4/model": [
        "../core/src/index.ts"
      ],
      "@c4docs/likec4/react": [
        "../react/src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "*.ts",
    "*.mts",
    "package.json"
  ],
  "references": [
    {
      "path": "../core/"
    },
    {
      "path": "../config/"
    },
    {
      "path": "../language-server/"
    },
    {
      "path": "../language-services/"
    },
    {
      "path": "../layouts/"
    },
    {
      "path": "../generators/"
    },
    {
      "path": "../log/"
    },
    {
      "path": "../react/"
    },
    {
      "path": "../../devops/"
    }
  ]
}
